def code (s : ℕ) := (rows.getD (s / 32) #[]).getD (s % 32) 0

def pack (c : ℕ) := packings.getD (c / 2048) []

def extra (c : ℕ) := c % 2048

def Valid (s : ℕ) (p : List ℕ) (k : ℕ) : Prop :=
  p.Pairwise (fun a b => a &&& b = 0) ∧ (∀ b ∈ p, b ∈ blocks ∧ b &&& s = 0) ∧
  (∀ e ∈ edges, ((s ||| k).testBit e.1 || (s ||| k).testBit e.2) = true) ∧
  (vertices k).card ≤ (p.map (fun b => (b.bitIndices.length + 1) / 2)).sum

def check (s c : ℕ) : Bool :=
  @decide (Valid s (pack c) (extra c)) (by unfold Valid; infer_instance)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 20000000 in
lemma certified : ∀ s : Fin 2048, check s.val (code s.val) = true := by decide +kernel

lemma sound (s : Fin 2048) : Valid s.val (pack (code s.val)) (extra (code s.val)) := by
  let d : Decidable (Valid s.val (pack (code s.val)) (extra (code s.val))) := by
    unfold Valid
    infer_instance
  exact @of_decide_eq_true _ d (certified s)

